  "preSignupTrigger": {
   "Type": "AWS::Lambda::Function",
   "Properties": {
    "FunctionName": "legalitt-prod-auth-preSignup",
    "Runtime": "nodejs22.x",
    "Handler": "index.preSignup",
    "Role": {
     "Fn::GetAtt": [
      "AuthRole",
      "Arn"
     ]
    },
    "Code": {
     "ZipFile": "\"use strict\";\nexports.preSignup = async (event) => {\n  const role = event.request.userAttributes[\"custom:role\"];\n  const adminProvisioning = event.triggerSource === \"PreSignUp_AdminCreateUser\";\n  if (\n    ![\"client\", \"advocate\", ...(adminProvisioning ? [\"admin\"] : [])].includes(\n      role,\n    )\n  ) {\n    throw new Error(\"Invalid registration role\");\n  }\n  // Verification remains Cognito's job; do not auto-confirm email or phone.\n  return event;\n};\n"
    },
    "Environment": {
     "Variables": {
      "ENVIRONMENT": "prod"
     }
    },
    "Tags": [
     {
      "Key": "environment",
      "Value": "prod"
     },
     {
      "Key": "application",
      "Value": "legalitt"
     }
    ]
   },
   "DependsOn": [
    "preSignupLogs"
   ],
   "Metadata": {
    "aws:cdk:path": "LegalittProd/Core/preSignupTrigger",
    "environment": "prod"
   }
  },
