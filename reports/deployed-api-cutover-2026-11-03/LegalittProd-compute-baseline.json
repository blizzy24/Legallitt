{
 "Parameters": {
  "VpcCidr": {
   "Type": "String",
   "Description": "Approved VPC CIDR; dev and prod must not overlap."
  },
  "PublicSubnet1Cidr": {
   "Type": "String",
   "Description": "Approved subnet CIDR within this stage VPC."
  },
  "PublicSubnet2Cidr": {
   "Type": "String",
   "Description": "Approved subnet CIDR within this stage VPC."
  },
  "PrivateSubnet1Cidr": {
   "Type": "String",
   "Description": "Approved subnet CIDR within this stage VPC."
  },
  "PrivateSubnet2Cidr": {
   "Type": "String",
   "Description": "Approved subnet CIDR within this stage VPC."
  },
  "NatMode": {
   "Type": "String",
   "AllowedValues": [
    "single",
    "per_az"
   ],
   "Description": "Choose shared NAT or one NAT per AZ."
  },
  "DatabaseInstanceClass": {
   "Type": "String",
   "AllowedPattern": "db\\..+",
   "Description": "Approved RDS instance class."
  },
  "DatabaseStorageGiB": {
   "Type": "Number",
   "Description": "Approved initial RDS storage.",
   "MinValue": 20
  },
  "Postgres16Version": {
   "Type": "String",
   "AllowedPattern": "16\\.[0-9]+",
   "Description": "Available Postgres 16 minor release in ap-south-1."
  },
  "TaskCpu": {
   "Type": "String",
   "AllowedValues": [
    "256",
    "512",
    "1024",
    "2048",
    "4096",
    "8192",
    "16384"
   ],
   "Description": "Approved Fargate CPU units."
  },
  "TaskMemoryMiB": {
   "Type": "String",
   "AllowedPattern": "[0-9]+",
   "Description": "Approved Fargate memory, valid for the chosen CPU."
  },
  "TaskCount": {
   "Type": "Number",
   "Description": "Approved desired task count.",
   "MinValue": 1
  },
  "ApiPort": {
   "Type": "Number",
   "Description": "Container port; also passed to the API as PORT.",
   "MaxValue": 65535,
   "MinValue": 1
  },
  "ApiImageTag": {
   "Type": "String",
   "Description": "Tag of the API image to publish to this stage ECR repository."
  },
  "CertificateArn": {
   "Type": "String",
   "Description": "ACM certificate ARN for the HTTPS ALB listener in ap-south-1."
  },
  "BootstrapVersion": {
   "Type": "AWS::SSM::Parameter::Value<String>",
   "Default": "/cdk-bootstrap/hnb659fds/version",
   "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]"
  }
 },
 "Conditions": {
  "NatPerAz": {
   "Fn::Equals": [
    {
     "Ref": "NatMode"
    },
    "per_az"
   ]
  }
 },
