  "RoleBoundary": {
   "Type": "AWS::IAM::ManagedPolicy",
   "Properties": {
    "ManagedPolicyName": "legalitt-prod-boundary",
    "PolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
       ],
       "Resource": [
        {
         "Fn::ImportValue": "LegalittProd-Core:ExportsOutputFnGetAttDocumentsArn9D87F4A8"
        }
       ]
      },
      {
       "Effect": "Allow",
       "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
       ],
       "Resource": [
        {
         "Fn::Join": [
          "",
          [
           {
            "Fn::ImportValue": "LegalittProd-Core:ExportsOutputFnGetAttDocumentsArn9D87F4A8"
           },
           "/*"
          ]
         ]
        }
       ]
      },
      {
       "Effect": "Allow",
       "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
       ],
       "Resource": [
        {
         "Fn::ImportValue": "LegalittProd-Core:ExportsOutputFnGetAttEncryptionKeyArn63627630"
        }
       ]
      },
      {
       "Effect": "Allow",
       "Action": [
        "secretsmanager:GetSecretValue",
