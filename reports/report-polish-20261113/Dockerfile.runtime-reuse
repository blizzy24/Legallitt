USER root
WORKDIR /repo
COPY packages/shared packages/shared
COPY apps/api apps/api
RUN cd packages/shared && node node_modules/typescript/bin/tsc \
 && cd /repo/apps/api && node node_modules/prisma/build/index.js generate \
 && node node_modules/typescript/bin/tsc
WORKDIR /repo/apps/api
USER node
