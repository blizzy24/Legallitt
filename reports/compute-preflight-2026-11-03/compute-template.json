    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "DBInstanceIdentifier": "legalitt-dev-database",
        "DBName": "legalitt",
        "Engine": "postgres",
        "EngineVersion": {
          "Ref": "Postgres16Version"
        },
        "DBInstanceClass": {
          "Ref": "DatabaseInstanceClass"
        },
        "AllocatedStorage": {
          "Ref": "DatabaseStorageGiB"
        },
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "KmsKeyId": {
          "Fn::ImportValue": "LegalittDev-Core:ExportsOutputFnGetAttEncryptionKeyArn63627630"
        },
        "MultiAZ": false,
        "PubliclyAccessible": false,
        "DeletionProtection": true,
        "MasterUsername": {
          "Fn::Join": [
            "",
            [
              "{{resolve:secretsmanager:",
              {
                "Fn::ImportValue": "LegalittDev-Core:ExportsOutputRefDatabaseSecretD7AA9253"
              },
              ":SecretString:username}}"
            ]
          ]
        },
        "MasterUserPassword": {
          "Fn::Join": [
            "",
            [
              "{{resolve:secretsmanager:",
              {
                "Fn::ImportValue": "LegalittDev-Core:ExportsOutputRefDatabaseSecretD7AA9253"
              },
              ":SecretString:password}}"
            ]
          ]
        },
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnets"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DatabaseSecurityGroup"
          }
        ],
        "Port": "5432",
        "Tags": [
          {
            "Key": "environment",
            "Value": "dev"
          },
          {
            "Key": "application",
            "Value": "legalitt"
          }
        ]
      },
      "UpdateReplacePolicy": "Retain",
      "DeletionPolicy": "Retain",
      "Metadata": {
        "aws:cdk:path": "LegalittDev/Compute/Database",
        "environment": "dev"
      }
    },
    "SecretAttachment": {
      "Type": "AWS::SecretsManager::SecretTargetAttachment",
      "Properties": {
        "SecretId": {
          "Fn::ImportValue": "LegalittDev-Core:ExportsOutputRefDatabaseSecretD7AA9253"
        },
        "TargetId": {
          "Ref": "Database"
