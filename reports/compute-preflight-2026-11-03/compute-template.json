        },
        "GroupDescription": "HTTPS ingress to Legalitt",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "environment",
            "Value": "dev"
          },
          {
