{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/fir/pay-placeholder",
      "destination": "/fir/payment",
      "permanent": false
    }
  ],
  "installCommand": "pnpm install --frozen-lockfile"
}
