# Copy to .env.local for mobile/web development against the deployed dev API.
# Sources: lib/auth.ts, lib/data-source.ts, ../../scripts/mobile-deployed.cjs,
# ../../scripts/local-api-proxy.cjs and ../api/README.txt.
# EXPO_PUBLIC_* values are embedded in the client bundle: NEVER put secrets here.
# Restart Expo or rebuild the web export after changing these values.
# TEMPORARY LOCAL CORS WORKAROUND: run pnpm mobile:deployed from the repository
# root. It starts BOTH the web app (http://localhost:8081) and loopback API proxy.
# The deployed dev API currently omits localhost from its CORS allowlist.
# Once an AWS operator allows http://localhost:8081, set EXPO_PUBLIC_API_URL to
# the deployed HTTPS origin below, unset EXPO_PUBLIC_LOCAL_API_PROXY and
# LOCAL_API_PROXY_TARGET, and use pnpm --filter @legalitt/mobile web without a proxy.

# Required for API-backed auth/data: reachable API origin, WITHOUT /api/v1.
# This loopback value is the temporary proxy, NOT a local backend or fixtures.
# This setup is for a browser on this machine, not a physical phone's loopback.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3002
# Required for real API data: only the exact value api enables it. Unset or any
# other value silently selects fixtures. Keep api for deployed-backend reviews.
EXPO_PUBLIC_DATA_SOURCE=api
# Required for the combined proxy command: 1 enables actionable missing-proxy
# feedback. Unset for a direct API connection. It does not change authentication.
EXPO_PUBLIC_LOCAL_API_PROXY=1
# Optional server-only upstream origin; defaults to this deployed dev API.
# Required to be HTTPS, without a path or credentials. NOT embedded in the app.
# This is a local workaround for CORS, removed when the deployed API allows localhost.
LOCAL_API_PROXY_TARGET=https://gvycg0n3u8.execute-api.ap-south-1.amazonaws.com

# Optional browser-check settings, NOT app configuration. Export them in the
# shell or use Node --env-file=apps/mobile/.env.local with the relevant root
# scripts; pnpm test:mobile does not automatically load this file.
# Sources: ../../scripts/mobile-smoke.mjs, mobile-auth-check.cjs,
# notice-browser-walk.cjs and ../api/README.txt. Keep private JSON outside Git.

# Required on Windows for mobile-smoke.mjs: installed Chrome executable path.
# Its default is a Mac path. Other legacy browser checks still hard-code Mac Chrome.
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# Required for local proxy mode and mobile-auth-check: existing web origin.
# Optional for other mobile-smoke setups: when unset it serves apps/mobile/dist
# itself. That server's random origin is NOT allowed by the local API proxy;
# use the running combined command and this exact origin for proxy-mode checks.
# SMOKE_BASE_URL=http://localhost:8081
# Optional port for mobile-smoke's own server; defaults to an available random port.
# SMOKE_PORT=8081
# Optional smoke mode; fixtures skips real session files. Keep unset for API mode.
# SMOKE_DATA_SOURCE=
# Optional: 1 enables the smoke's fixture-network assertions; normally leave unset
# when checking a build intentionally connected to the deployed API.
# SMOKE_ASSERT_FIXTURES=
# Required for API-mode mobile-smoke: private JSON auth response for a dev client.
# SMOKE_CLIENT_SESSION=
# Required for API-mode mobile-smoke: private JSON auth response for a dev advocate.
# SMOKE_ADVOCATE_SESSION=
# Required only for mobile-auth-check: private JSON with fixtures array entries
# containing role/email/password for dev client and advocate. Never commit it.
# AUTH_TEST_FIXTURES=
# Required only for notice-browser-walk: private JSON with client, advocate and admin
# auth responses. This legacy script also needs its Mac-specific paths corrected.
# NOTICE_WALK_SESSIONS=
# Optional API origin for notice-browser-walk; defaults to http://localhost:3001.
# NOTICE_WALK_API_URL=https://gvycg0n3u8.execute-api.ap-south-1.amazonaws.com
