    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "libphonenumber-js": "^1.13.15",
    "lucide-react-native": "^1.46.0",
    "pdfjs-dist": "^6.5.438",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
