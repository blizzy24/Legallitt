# Copy to .env.local when overriding admin defaults. Sources: vite.config.ts,
# src/session.tsx and README.txt. Never put passwords or AWS keys in VITE_* values:
# they are public build-time configuration. Restart Vite/rebuild after changes.

# Optional: API origin WITHOUT /api/v1. Unset uses the browser's current origin
# and /api requests go through the local Vite proxy. Required for a deployed SPA
# that has no same-origin API proxy. Leave empty for the local Vite proxy below.
# For Vercel builds use https://gvycg0n3u8.execute-api.ap-south-1.amazonaws.com.
VITE_API_BASE_URL=
# Optional: local Vite /api proxy target; defaults to http://127.0.0.1:3001.
# Used by same-origin API calls when VITE_API_BASE_URL is unset. It is NOT a
# production proxy and does not change the API's allowed CORS origins.
# Local CORS workaround: Vite already proxies /api server-side, so point it at
# deployed dev and run pnpm --filter @legalitt/admin dev. No separate proxy command.
# Once AWS CORS allows http://127.0.0.1:5173, VITE_API_BASE_URL may use deployed dev
# directly and this override can be removed. For a local API use the default above.
ADMIN_API_TARGET=https://gvycg0n3u8.execute-api.ap-south-1.amazonaws.com
