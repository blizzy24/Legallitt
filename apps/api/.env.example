# Copy to .env.local ONLY when running the API locally. Mobile against the
# deployed API does not need this file, PostgreSQL, or local AWS credentials.
# Sources: README.txt, src/main.ts, src/database.ts, src/auth/auth.service.ts,
# src/phone-auth/*, src/documents/document-storage.ts, src/*/*.module.ts,
# src/demo/demo-config.ts, src/ai/README.txt, prisma.config.ts and scripts/*.
# Never commit real passwords, tokens, AWS keys or provider keys. Obtain access
# to existing AWS secrets through the normal AWS credential chain; do not rotate
# demo credentials to set up a machine. Optional commented settings stay unset.

# Required: local API listening port, integer 1..65535 (src/main.ts).
PORT=3001
# Required for demo sign-in/seeding, progression and Gemini: development stage.
ENVIRONMENT=dev
# Required for this development setup; production forbids local DB/phone demo.
NODE_ENV=development
# Required for browser access: exact comma-separated origins; no default origins.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:5173

# Required for a local DB unless DATABASE_SECRET_ARN is used. Replace the password
# placeholder with the URL-encoded password from infra/local/.env.local.
DATABASE_URL=postgresql://legalitt:<URL-encoded-local-password>@127.0.0.1:55432/legalitt
# Required for db:local:migrate and database integration tests; a SEPARATE local,
# migrated, base-seeded database. If unset, test-preflight skips database tests.
LEGALITT_TEST_DATABASE_URL=postgresql://legalitt:<URL-encoded-local-password>@127.0.0.1:55432/legalitt_test
# Required for AWS-hosted DB use; optional locally. Takes precedence over
# DATABASE_URL. Secret JSON: host, port, username, password, optional dbname.
# DATABASE_SECRET_ARN=
# Required with DATABASE_SECRET_ARN if its JSON has no dbname; otherwise optional.
# DATABASE_NAME=
# Required when the RDS CA is not already trusted: path to the public CA bundle
# read by Node at startup. The API Dockerfile supplies this in its Linux image.
# NODE_EXTRA_CA_CERTS=
# Optional for the deployed migration helper: path to the single Mumbai RDS root
# certificate. The Dockerfile supplies it; local Compose PostgreSQL needs no CA.
# PRISMA_RDS_CA=

# Required for auth: existing Dev Core app-config secret name or ARN. Contains
# userPoolId/clientId; its bucketName is also used unless DOCUMENT_BUCKET is set.
AUTH_CONFIG_SECRET_ARN=legalitt-dev/app-config
# Required for phone demo, demo seeds and enabled automatic demo actions:
# existing secret name/ARN containing the demo password. Never put the password here.
DEMO_AUTH_SECRET_ARN=legalitt-dev/demo-auth
# Optional document bucket override; otherwise app-config supplies bucketName.
# DOCUMENT_BUCKET=
# Optional Bedrock region; defaults to ap-south-1 and must remain ap-south-1.
# Other current API AWS clients explicitly select ap-south-1 in their code.
AWS_REGION=ap-south-1
# Optional Bedrock fallback only when AWS_REGION is unset.
# AWS_DEFAULT_REGION=ap-south-1
# Optional AWS SDK profile selection (SDK credential chain, not an app secret).
# AWS_PROFILE=

# Optional: simulated (default) or demo; both select phone OTP code 123456.
# live is not implemented and fails startup; never enable the demo in production.
PHONE_AUTH_MODE=demo
# Optional: simulated (default). live fails: no real payments adapter is built.
PAYMENTS_MODE=simulated
# Optional: simulated (default). In-app notifications persist; no external send.
# live fails because no external notification adapter is built.
NOTIFY_MODE=simulated
# Optional: simulated (default). live fails: no carrier API adapter is built.
COURIER_MODE=simulated
# Optional: live for human admin delivery confirmation (requires auth config).
# Code defaults to simulated; use live to match the built admin workflow.
ADMIN_UI_MODE=live
# KYC_MODE is named in architecture section 2.11, but no runtime consumer exists
# in this checkout. Setting it currently has no effect; no value is prescribed.

# Optional AI adapter: simulated (default), gemini (dev only), or bedrock.
AI_MODE=simulated
# Required ONLY for AI_MODE=gemini: inject the key securely into the process.
# Deployed dev receives it from Secrets Manager. Do not commit a real key.
# GEMINI_API_KEY=
# Optional Gemini model; default below comes from the current adapter.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional per-task Bedrock model IDs; defaults below are the audited India-only
# profile. AI_MODE=bedrock also requires resolvable AWS credentials/model access.
# BEDROCK_SUBJECT_MODEL_ID=in.anthropic.claude-haiku-4-5-20251001-v1:0
# Optional Bedrock demand-options model override.
# BEDROCK_DEMANDS_MODEL_ID=in.anthropic.claude-haiku-4-5-20251001-v1:0
# Optional Bedrock notice-drafting model override.
# BEDROCK_NOTICE_MODEL_ID=in.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional master on/off switch: defaults on for dev + development, off otherwise.
# Explicit on is forbidden outside dev or with NODE_ENV=production.
DEMO_PROGRESSION=on
# Optional on/off switches below; ignored when the master is off.
# Assignment defaults off: a real admin assigns an advocate.
DEMO_ASSIGNMENT=off
# Draft start/restart defaults off: a real advocate acts.
DEMO_DRAFT_START=off
# Draft submission defaults off: a real advocate sends it to the client.
DEMO_DRAFT_SUBMIT=off
# Dispatch defaults off: a real advocate books and dispatches it.
DEMO_DISPATCH=off
# Courier milestones default on; stop at Out for Delivery.
DEMO_SHIPMENT_MILESTONES=on
# Delivery confirmation defaults off: a real admin records delivery/POD.
# Turning this on requires ADMIN_UI_MODE=simulated.
DEMO_DELIVERY_CONFIRMATION=off
# Required only when assignment is enabled: nonnegative integer milliseconds.
# 30000 matches the current Dev Compute configuration; there is no code default.
DEMO_ASSIGN_DELAY_MS=30000
# Required only when draft start/restart is enabled; milliseconds, no code default.
DEMO_DRAFT_START_DELAY_MS=30000
# Required only when draft submission is enabled; milliseconds, no code default.
DEMO_DRAFT_DONE_DELAY_MS=30000
# Required only when dispatch is enabled; milliseconds, no code default.
DEMO_DISPATCH_DELAY_MS=30000
# Required when milestones OR delivery confirmation are enabled; milliseconds.
# 5000 matches Dev Compute; there is no code default.
DEMO_SHIPMENT_STEP_MS=5000
