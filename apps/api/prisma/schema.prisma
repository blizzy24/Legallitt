// Transcribed from architecture §4.3. SQL names, types, defaults and FKs preserved.
// CHECK, CITEXT installation and array NOT NULL are preserved in the SQL migration:
// Prisma's generated SQL omits NOT NULL on lists despite non-optional list fields.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  client
  advocate
  admin

  @@map("user_role")
}

enum VerificationStatus {
  not_started
  in_review
  approved
  rejected
  needs_update

  @@map("verification_status")
}

enum CaseStatus {
  draft
  submitted
  payment_pending
  paid
  assigning
  assigned
  advocate_accepted
  advocate_declined
  in_progress
  client_review
  changes_requested
  approved
  dispatching
  dispatched
  completed
  cancelled
  refunded

  @@map("case_status")
}

enum PaymentStatus {
  created
  pending
  captured
  failed
  refunded

  @@map("payment_status")
}

enum PayoutStatus {
  pending
  released
  processing
  paid
  failed
  reversed

  @@map("payout_status")
}

model User {
  auth_events AuthEvent[]
  payments_paid Payment[] @relation("payment_payer")
  id                                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cognito_sub                         String            @unique
  role                                UserRole
  full_name                           String
  email                               String?           @unique @db.Citext
  phone                               String?           @unique
  phone_verified                      Boolean           @default(false)
  email_verified                      Boolean           @default(false)
  status                              String            @default("active")
  created_at                          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime          @default(now()) @db.Timestamptz(6)
  advocate_profiles_user_id_relations AdvocateProfile?  @relation("advocate_profiles_user_id_users")
  cases_client_id_relations           Case[]            @relation("cases_client_id_users")
  cases_advocate_id_relations         Case[]            @relation("cases_advocate_id_users")
  case_events_actor_id_relations      CaseEvent[]       @relation("case_events_actor_id_users")
  documents_owner_id_relations        Document[]        @relation("documents_owner_id_users")
  drafts_created_by_relations         Draft[]           @relation("drafts_created_by_users")
  draft_reviews_reviewer_id_relations DraftReview[]     @relation("draft_reviews_reviewer_id_users")
  messages_sender_id_relations        Message[]         @relation("messages_sender_id_users")
  payouts_advocate_id_relations       Payout[]          @relation("payouts_advocate_id_users")
  payouts_released_by_relations       Payout[]          @relation("payouts_released_by_users")
  hearings_created_by_relations       Hearing[]         @relation("hearings_created_by_users")
  kyc_verifications_user_id_relations KycVerification[] @relation("kyc_verifications_user_id_users")
  notifications_user_id_relations     Notification[]    @relation("notifications_user_id_users")
  admin_actions_admin_id_relations    AdminAction[]     @relation("admin_actions_admin_id_users")

  @@map("users")
}

model AdvocateProfile {
  user_id                String             @id @db.Uuid
  bar_council_state      String?
  bar_council_number     String?
  enrolment_year         Int?
  practice_areas         String[]           @default([])
  languages              String[]           @default([])
  courts                 String[]           @default([])
  city                   String?
  state                  String?
  years_experience       Int?
  bio                    String?
  consultation_fee_paise BigInt?
  verification           VerificationStatus @default(not_started)
  verified_at            DateTime?          @db.Timestamptz(6)
  rating_avg             Decimal?           @db.Decimal(2, 1)
  rating_count           Int                @default(0)
  rzp_linked_account_id  String?
  rzp_account_status     String?
  photo_key              String?
  education              String?
  created_at             DateTime           @default(now()) @db.Timestamptz(6)
  updated_at             DateTime           @default(now()) @db.Timestamptz(6)
  user_id_relation       User               @relation("advocate_profiles_user_id_users", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("advocate_profiles")
}

model Service {
  fee_policies                            FeePolicy[]
  code                                    String           @id
  name                                    String
  active                                  Boolean          @default(true)
  config                                  Json             @default("{}") @db.JsonB
  service_pricing_service_code_relations  ServicePricing[] @relation("service_pricing_service_code_services")
  commission_rates_service_code_relations CommissionRate[] @relation("commission_rates_service_code_services")
  cases_service_code_relations            Case[]           @relation("cases_service_code_services")

  @@map("services")
}

model ServicePricing {
  duration_minutes           Int?
  fee_policy_id              String? @db.Uuid
  fee_policy                 FeePolicy? @relation("tariff_policy", fields: [fee_policy_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  delivery_policies          FeePolicy[] @relation("policy_delivery")
  price_quotes               CasePriceQuote[] @relation("quote_price")
  delivery_quotes            CasePriceQuote[] @relation("quote_delivery")
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_code               String
  tier                       String?
  variant                    String?
  base_amount_paise          BigInt
  gst_bps                    Int       @default(1800)
  confirmed                  Boolean   @default(false)
  source_note                String?
  effective_from             DateTime  @default(now()) @db.Timestamptz(6)
  effective_to               DateTime? @db.Timestamptz(6)
  service_code_relation      Service   @relation("service_pricing_service_code_services", fields: [service_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  cases_pricing_id_relations Case[]    @relation("cases_pricing_id_service_pricing")

  @@map("service_pricing")
}

model CommissionRate {
  quotes                CasePriceQuote[]
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_code          String
  rate_bps              Int
  confirmed             Boolean   @default(false)
  effective_from        DateTime  @default(now()) @db.Timestamptz(6)
  effective_to          DateTime? @db.Timestamptz(6)
  service_code_relation Service   @relation("commission_rates_service_code_services", fields: [service_code], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@map("commission_rates")
}

model Case {
  fir_lifecycle FirLifecycle?
  assignments CaseAssignment[]
  fir_submissions FirSubmission[]
  fir_identity_returns FirIdentityReturn[]
  price_quotes                      CasePriceQuote[]
  id                                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference                         String          @unique
  service_code                      String
  client_id                         String          @db.Uuid
  advocate_id                       String?         @db.Uuid
  status                            CaseStatus      @default(draft)
  sub_status                        String?
  matter_type                       String?
  subject_matter                    String?
  subject_line                      String?
  compliance_period_days            Int?
  legal_demand                      Json?           @db.JsonB
  tier                              String?
  title                             String?
  notice_document_id                String?         @db.Uuid
  details                           Json            @default("{}") @db.JsonB
  pricing_id                        String?         @db.Uuid
  created_at                        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at                        DateTime        @default(now()) @db.Timestamptz(6)
  completed_at                      DateTime?       @db.Timestamptz(6)
  service_code_relation             Service         @relation("cases_service_code_services", fields: [service_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  client_id_relation                User            @relation("cases_client_id_users", fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  advocate_id_relation              User?           @relation("cases_advocate_id_users", fields: [advocate_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pricing_id_relation               ServicePricing? @relation("cases_pricing_id_service_pricing", fields: [pricing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  case_events_case_id_relations     CaseEvent[]     @relation("case_events_case_id_cases")
  case_parties_case_id_relations    CaseParty[]     @relation("case_parties_case_id_cases")
  documents_case_id_relations       Document[]      @relation("documents_case_id_cases")
  drafts_case_id_relations          Draft[]         @relation("drafts_case_id_cases")
  message_threads_case_id_relations MessageThread[] @relation("message_threads_case_id_cases")
  payments_case_id_relations        Payment[]       @relation("payments_case_id_cases")
  payouts_case_id_relations         Payout[]        @relation("payouts_case_id_cases")
  ledger_entries_case_id_relations  LedgerEntry[]   @relation("ledger_entries_case_id_cases")
  shipments_case_id_relations       Shipment[]      @relation("shipments_case_id_cases")
  hearings_case_id_relations        Hearing[]       @relation("hearings_case_id_cases")
  consultations_case_id_relations   Consultation[]  @relation("consultations_case_id_cases")
  notifications_case_id_relations   Notification[]  @relation("notifications_case_id_cases")

  @@index([client_id, status])
  @@index([advocate_id, status])
  @@index([service_code, status])
  notice_document_id_relation       Document?       @relation("cases_notice_document_id_documents", fields: [notice_document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("cases")
}

model FirPolicy {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version Int @unique
  config Json @db.JsonB
  effective_from DateTime @default(now()) @db.Timestamptz(6)
  lifecycles FirLifecycle[]
  @@map("fir_policies")
}
model FirLifecycle {
  case_id String @id @db.Uuid
  revision Int @default(0)
  current_submission_id String? @db.Uuid
  policy_id String @db.Uuid
  paid_at DateTime? @db.Timestamptz(6)
  completing_assignment_id String? @db.Uuid
  advocate_entitlement_paise BigInt?
  commission_rate_id String? @db.Uuid
  case Case @relation(fields:[case_id],references:[id],onDelete:Cascade)
  policy FirPolicy @relation(fields:[policy_id],references:[id])
  @@map("fir_lifecycles")
}
model CaseAssignment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id String @db.Uuid
  advocate_id String @db.Uuid
  assigned_by String? @db.Uuid
  assigned_at DateTime @default(now()) @db.Timestamptz(6)
  ended_at DateTime? @db.Timestamptz(6)
  end_reason String?
  case Case @relation(fields:[case_id],references:[id],onDelete:Cascade)
  submissions FirSubmission[]
  @@index([case_id,assigned_at])
  @@map("case_assignments")
}
model FirSubmission {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id String @db.Uuid
  assignment_id String @db.Uuid
  draft_id String @unique @db.Uuid
  version Int
  document_id String @db.Uuid
  identity_document_id String? @db.Uuid
  identity_checked_by String? @db.Uuid
  identity_checked_at DateTime? @db.Timestamptz(6)
  supersedes_submission_id String? @unique @db.Uuid
  state String @default("pending")
  draft_reason String?
  decided_by String? @db.Uuid
  decided_at DateTime? @db.Timestamptz(6)
  submitted_at DateTime @default(now()) @db.Timestamptz(6)
  case Case @relation(fields:[case_id],references:[id],onDelete:Cascade)
  assignment CaseAssignment @relation(fields:[assignment_id],references:[id],onDelete:Cascade)
  @@index([case_id,submitted_at])
  @@map("fir_submissions")
}
model FirIdentityReturn {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id String @db.Uuid
  submission_id String @db.Uuid
  document_id String @unique @db.Uuid
  rejected_by String @db.Uuid
  rejected_at DateTime @default(now()) @db.Timestamptz(6)
  reason String @default("unmasked_aadhaar")
  replacement_document_id String? @db.Uuid
  state String @default("replacement_required")
  reviewed_by String? @db.Uuid
  reviewed_at DateTime? @db.Timestamptz(6)
  purge_status String @default("pending")
  purge_after DateTime @db.Timestamptz(6)
  purge_attempted_at DateTime? @db.Timestamptz(6)
  case Case @relation(fields:[case_id],references:[id],onDelete:Cascade)
  @@index([case_id,state])
  @@map("fir_identity_returns")
}

model CaseEvent {
  source String @default("real")
  id                BigInt      @id @default(autoincrement())
  case_id           String      @db.Uuid
  type              String
  actor_id          String?     @db.Uuid
  actor_role        UserRole?
  from_status       CaseStatus?
  to_status         CaseStatus?
  payload           Json        @default("{}") @db.JsonB
  created_at        DateTime    @default(now()) @db.Timestamptz(6)
  case_id_relation  Case        @relation("case_events_case_id_cases", fields: [case_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor_id_relation User?       @relation("case_events_actor_id_users", fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([case_id, created_at])
  @@map("case_events")
}

model CaseParty {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id          String @db.Uuid
  kind             String
  name             String
  age              Int?
  salutation       String?
  relation         String?
  relative_name    String?
  details          Json   @default("{}") @db.JsonB
  case_id_relation Case   @relation("case_parties_case_id_cases", fields: [case_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("case_parties")
}

model Document {
  identity_evidence                   Json?      @db.JsonB
  id                                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id                             String?    @db.Uuid
  owner_id                            String     @db.Uuid
  kind                                String
  filename                            String
  s3_key                              String
  mime_type                           String
  size_bytes                          BigInt
  page_count                          Int?
  status                              String     @default("uploaded")
  simulated                           Boolean    @default(false)
  created_at                          DateTime   @default(now()) @db.Timestamptz(6)
  case_id_relation                    Case?      @relation("documents_case_id_cases", fields: [case_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  owner_id_relation                   User       @relation("documents_owner_id_users", fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages_document_id_relations      Message[]  @relation("messages_document_id_documents")
  shipments_receipt_document_id_relations Shipment[] @relation("shipments_receipt_document_id_documents")
  shipments_pod_document_id_relations Shipment[] @relation("shipments_pod_document_id_documents")

  drafts_document_id_relations          Draft[]    @relation("drafts_document_id_documents")
  cases_notice_document_id_relations    Case[]     @relation("cases_notice_document_id_documents")

  @@map("documents")
}

model Draft {
  compliance_period_days Int?
  closing_policy Json? @db.JsonB
  id                               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id                          String        @db.Uuid
  kind                             String
  version                          Int
  content                          Json          @db.JsonB
  generated_by                     String?
  created_by                       String        @db.Uuid
  document_id                      String?       @db.Uuid
  created_at                       DateTime      @default(now()) @db.Timestamptz(6)
  document_id_relation             Document?     @relation("drafts_document_id_documents", fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  case_id_relation                 Case          @relation("drafts_case_id_cases", fields: [case_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  created_by_relation              User          @relation("drafts_created_by_users", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  draft_reviews_draft_id_relations DraftReview[] @relation("draft_reviews_draft_id_drafts")

  @@unique([case_id, kind, version])
  @@map("drafts")
}

model DraftReview {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draft_id             String   @db.Uuid
  reviewer_id          String   @db.Uuid
  decision             String
  comment              String?
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  draft_id_relation    Draft    @relation("draft_reviews_draft_id_drafts", fields: [draft_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewer_id_relation User     @relation("draft_reviews_reviewer_id_users", fields: [reviewer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("draft_reviews")
}

model MessageThread {
  id                           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id                      String?   @db.Uuid
  kind                         String
  created_at                   DateTime  @default(now()) @db.Timestamptz(6)
  case_id_relation             Case?     @relation("message_threads_case_id_cases", fields: [case_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages_thread_id_relations Message[] @relation("messages_thread_id_message_threads")

  @@map("message_threads")
}

model Message {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  thread_id            String        @db.Uuid
  sender_id            String        @db.Uuid
  body                 String?
  document_id          String?       @db.Uuid
  created_at           DateTime      @default(now()) @db.Timestamptz(6)
  read_at              DateTime?     @db.Timestamptz(6)
  thread_id_relation   MessageThread @relation("messages_thread_id_message_threads", fields: [thread_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sender_id_relation   User          @relation("messages_sender_id_users", fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  document_id_relation Document?     @relation("messages_document_id_documents", fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([thread_id, created_at])
  @@map("messages")
}

model Payment {
  quote_id                            String? @unique @db.Uuid
  quote                               CasePriceQuote? @relation(fields: [quote_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payer_id String @db.Uuid
  payer User @relation("payment_payer", fields: [payer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  simulated Boolean @default(false)
  id                                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id                             String        @db.Uuid
  purpose                             String
  base_amount_paise                   BigInt
  gst_paise                           BigInt
  total_paise                         BigInt
  status                              PaymentStatus @default(created)
  rzp_order_id                        String?       @unique
  rzp_payment_id                      String?       @unique
  idempotency_key                     String        @unique
  created_at                          DateTime      @default(now()) @db.Timestamptz(6)
  captured_at                         DateTime?     @db.Timestamptz(6)
  case_id_relation                    Case          @relation("payments_case_id_cases", fields: [case_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payouts_payment_id_relations        Payout[]      @relation("payouts_payment_id_payments")
  ledger_entries_payment_id_relations LedgerEntry[] @relation("ledger_entries_payment_id_payments")

  @@map("payments")
}

// Immutable policies and checkout snapshots. Version references inside a quote
// are also stored in its JSON snapshot, including the complete applied rules.
model PageOveragePolicy {
  quotes                CasePriceQuote[]
  id                    String @id @db.Uuid
  included_pages        Int
  unit_amount_paise     BigInt
  gst_bps               Int
  aggregation           String
  page_basis            String
  revenue_recipient     String
  confirmed             Boolean
  source_note           String
  effective_from        DateTime @db.Timestamptz(6)
  effective_to          DateTime? @db.Timestamptz(6)
  fee_policies          FeePolicy[]
  @@map("page_overage_policies")
}

model FeePolicy {
  quotes                CasePriceQuote[]
  id                    String @id @db.Uuid
  service_code          String
  service               Service @relation(fields: [service_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  pricing_mode          String
  base_represents       String
  platform_calculation  String
  gst_basis             String
  delivery_recipient    String
  rounding              String
  delivery_pricing_id   String? @db.Uuid
  delivery_pricing      ServicePricing? @relation("policy_delivery", fields: [delivery_pricing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  page_overage_policy_id String @db.Uuid
  page_overage_policy   PageOveragePolicy @relation(fields: [page_overage_policy_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  confirmed             Boolean
  source_note           String
  effective_from        DateTime @db.Timestamptz(6)
  effective_to          DateTime? @db.Timestamptz(6)
  prices                ServicePricing[] @relation("tariff_policy")
  @@index([service_code, effective_from])
  @@map("fee_policies")
}

model CasePriceQuote {
  id                    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id               String @db.Uuid
  case                  Case @relation(fields: [case_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pricing_id            String @db.Uuid
  pricing               ServicePricing @relation("quote_price", fields: [pricing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  commission_rate_id    String? @db.Uuid
  commission_rate       CommissionRate? @relation(fields: [commission_rate_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fee_policy_id         String? @db.Uuid
  fee_policy            FeePolicy? @relation(fields: [fee_policy_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  delivery_pricing_id   String? @db.Uuid
  delivery_pricing      ServicePricing? @relation("quote_delivery", fields: [delivery_pricing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  page_overage_policy_id String? @db.Uuid
  page_overage_policy    PageOveragePolicy? @relation(fields: [page_overage_policy_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  document_fingerprint  String
  snapshot              Json @db.JsonB
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  payment               Payment?
  @@index([case_id, created_at])
  @@map("case_price_quotes")
}

model Payout {
  id                                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id                            String        @db.Uuid
  advocate_id                        String        @db.Uuid
  payment_id                         String        @db.Uuid
  gross_paise                        BigInt
  commission_rate_bps                Int
  commission_paise                   BigInt
  net_paise                          BigInt
  status                             PayoutStatus  @default(pending)
  rzp_transfer_id                    String?
  utr                                String?
  released_by                        String?       @db.Uuid
  released_at                        DateTime?     @db.Timestamptz(6)
  created_at                         DateTime      @default(now()) @db.Timestamptz(6)
  case_id_relation                   Case          @relation("payouts_case_id_cases", fields: [case_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  advocate_id_relation               User          @relation("payouts_advocate_id_users", fields: [advocate_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_id_relation                Payment       @relation("payouts_payment_id_payments", fields: [payment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  released_by_relation               User?         @relation("payouts_released_by_users", fields: [released_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ledger_entries_payout_id_relations LedgerEntry[] @relation("ledger_entries_payout_id_payouts")

  @@map("payouts")
}

model LedgerEntry {
  id                  BigInt   @id @default(autoincrement())
  account             String
  case_id             String?  @db.Uuid
  payment_id          String?  @db.Uuid
  payout_id           String?  @db.Uuid
  direction           String
  amount_paise        BigInt
  memo                String?
  created_at          DateTime @default(now()) @db.Timestamptz(6)
