{
  "name": "@legalitt/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc",
    "typecheck": "prisma generate && tsc --noEmit",
    "start": "node --env-file-if-exists=.env.local dist/src/main.js",
    "test": "pnpm build && node --test tests/*.cjs",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "pnpm build && prisma db seed",
    "db:seed-demo": "pnpm build && node --env-file-if-exists=.env.local dist/prisma/seed-demo.js",
    "db:local:migrate": "node --env-file=.env.local scripts/migrate-local.cjs",
    "db:local:seed": "pnpm build && node --env-file=.env.local dist/prisma/seed.js",
    "test:local": "pnpm build && node --env-file=.env.local --test tests/*.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1153.0",
    "@aws-sdk/client-s3": "3.1153.0",
    "@aws-sdk/client-secrets-manager": "^3.1153.0",
    "@aws-sdk/s3-presigned-post": "3.1153.0",
    "@aws-sdk/s3-request-presigner": "3.1153.0",
    "@legalitt/shared": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "aws-jwt-verify": "^5.2.1",
    "file-type": "21.3.0",
    "image-size": "2.0.2",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "reflect-metadata": "0.2.2",
    "regenerator-runtime": "0.14.1",
    "rxjs": "7.8.2",
    "zod": "4.6.0"
  }
}
