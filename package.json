{
  "name": "legalitt",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "mobile": "pnpm --filter @legalitt/mobile start",
    "mobile:deployed": "node scripts/mobile-deployed.cjs",
    "test:local-proxy": "node --test scripts/tests/local-api-proxy.cjs",
    "test:mobile": "node scripts/mobile-smoke.mjs",
    "test:fixtures": "node scripts/check-batch-flows.cjs && node scripts/check-payment-rounding.cjs",
    "test:case-spine": "node --test scripts/check-case-spine.cjs",
    "demo:password": "node infra/scripts/rotate-demo-password.cjs"
  },
  "devDependencies": {
    "turbo": "2.11.9",
    "typescript": "~6.0.3",
    "pngjs": "7.0.0",
    "puppeteer-core": "24.16.0"
  }
}
