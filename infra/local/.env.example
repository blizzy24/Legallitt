# Copy to .env.local ONLY when setting up local PostgreSQL (not needed for a
# frontend using the deployed API). Sources: compose.yaml and apps/api/README.txt.
# docker compose --env-file infra/local/.env.local -f infra/local/compose.yaml up -d --wait

# Required: choose a private local PostgreSQL password; no default is supplied.
# Put the same password, URL-encoded, into both database URLs in apps/api/.env.local.
# Compose fixes the user/database to legalitt and binds 127.0.0.1:55432; the init
# SQL creates legalitt_test. Changing this value does not rotate an existing DB.
POSTGRES_PASSWORD=
